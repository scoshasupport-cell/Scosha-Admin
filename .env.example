# Scosha Next.js storefront
# Use relative /api/v1 so phones on LAN work (proxied by Next → backend).
# Same Google OAuth client id as backend GOOGLE_CLIENT_ID. Leave empty until it is created.
# Same value as backend GOOGLE_CLIENT_ID (Web OAuth client)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=61100186731-d5l54rhnu917ftfks7enml21btdspa35.apps.googleusercontent.com

NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_API_PROXY=http://127.0.0.1:5000
NEXT_PUBLIC_ADMIN_PROXY=http://127.0.0.1:5174

# Public storefront URL (absolute links for Meta catalog feed, emails, shares)
# Production example: https://scosha.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Meta catalog feed currency (price column format: "49.00 USD")
NEXT_PUBLIC_META_FEED_CURRENCY=USD
# Optional: backend origin used only by /api/meta-feed (defaults to NEXT_PUBLIC_API_PROXY)
# META_FEED_API_URL=http://127.0.0.1:5000

# Perfect Corp / YouCam YCE API key is server-side only (set on backend / Vercel backend env):
# PERFECT_CORP_API_KEY=
# PERFECT_CORP_API_BASE=https://yce-api-01.makeupar.com
