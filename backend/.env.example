# Scosha backend — fully independent stack (own MySQL, Cloudinary, SMTP, secrets).
# Do NOT point any of these at Amaz credentials or Amaz databases.
NODE_ENV=development
PORT=5000

# Dedicated Scosha MySQL schema only. Never point staging at production.
# connection_limit is Prisma's pool size for THIS process (default ≈ num_cpus*2+1).
# Instances × connection_limit must stay below MySQL max_connections (leave ~20 for admin).
# docker-compose: mysql://scosha:scosha123@localhost:3307/scosha
DATABASE_URL=mysql://scosha:scosha123@localhost:3306/scosha?connection_limit=10&pool_timeout=10
# Optional isolated schema for catalog-scale benches. Never the production database.
# BENCH_DATABASE_URL=mysql://scosha:scosha123@localhost:3306/scosha_bench?connection_limit=10

JWT_ACCESS_SECRET=your-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

COOKIE_SECRET=your-cookie-secret-change-in-production
GUEST_SESSION_COOKIE=guestSessionId

BCRYPT_SALT_ROUNDS=12

# Scosha-owned Cloudinary account (create at https://cloudinary.com — do not reuse Amaz)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=scosha

# --- Email (production: use Resend + verified domain — Gmail lands in spam) ---
# 1) Create https://resend.com account, verify your domain, copy API key
# 2) Set RESEND_API_KEY + SMTP_FROM on that domain (SPF/DKIM/DMARC from Resend DNS)
# 3) Leave SMTP_HOST/USER/PASS empty when using RESEND_API_KEY
RESEND_API_KEY=
SMTP_FROM=SCOSHA <orders@yourdomain.com>
SMTP_REPLY_TO=support@yourdomain.com
ADMIN_EMAIL=admin@scosha.com
# Dev-only fallback (not for customer mail in production):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_ENABLED=1
SMTP_TIMEOUT_MS=4000

# Free Google Cloud OAuth client (Web). Same id as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the storefront.
# Authorized JavaScript origins: http://localhost:3000 and the live site URL.
GOOGLE_CLIENT_ID=

STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_MAX=5

FREE_SHIPPING_THRESHOLD=150
DEFAULT_SHIPPING_CHARGE=9
TAX_RATE=0
USD_TO_LBP=89500

LOG_LEVEL=debug

PERFECT_CORP_API_KEY=
PERFECT_CORP_SECRET_KEY=
PERFECT_CORP_API_BASE=https://yce-api-01.makeupar.com

# Google Gemini — powers the AI Shopping Assistant (image understanding, face/body/furniture
# analysis and candidate reranking). All vision calls go through the model chain below:
# GEMINI_MODEL is tried first, then each GEMINI_FALLBACK_MODELS entry. Models that return
# 404/429/5xx are put in a short cooldown automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# Attach the internal decision trace to /ai-assistant/analyze responses (dev only, never in prod).
AI_DEBUG_RESPONSE=false
